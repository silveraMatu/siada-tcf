# Copiar a .env y completar
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_DB=
JWT_SECRET=                      # obligatoria, 32 caracteres o más (por ejemplo: openssl rand -hex 32)

# Opcionales (valores por defecto entre paréntesis)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# PORT=3000
# NODE_ENV=development
# CORS_ORIGIN=http://localhost:5173,http://localhost:4173   (sin definir: abierto en desarrollo, cerrado en producción)
# SWAGGER_ENABLED=true                                       (en producción Swagger está apagado salvo que se active)
# DB_SYNCHRONIZE=false                                       (por defecto true: el esquema sigue a las entidades)
# DB_LOGGING=true                                            (muestra las consultas con sus parámetros: solo para depurar)
# DB_DROP_SCHEMA=true                                        (borra TODAS las tablas al arrancar; ignorado en producción)

# Las usa `npm run crear-admin` (crea o promueve al primer administrador) y, por lo tanto, `npm run start:dev`, que lo ejecuta antes de arrancar:
# si faltan, start:dev no levanta el servidor
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DNI=
# ADMIN_NOMBRE=
# ADMIN_APELLIDO=

# Asistente de IA (módulo `asistente`, llama al servicio ia-agent-service). Sin las dos primeras el backend arranca igual
# y POST /api/v1/asistente/consultas responde 503
# IA_SERVICE_URL=http://127.0.0.1:8000
# IA_SERVICE_API_KEY=                                        (la SERVICE_API_KEY del ia-agent-service, 32 caracteres o más)
# IA_SERVICE_TIMEOUT_MS=120000                               (una consulta puede encadenar varias llamadas al modelo)

# Logs operativos (stdout, JSON) y bitácora de actividad
# LOG_LEVEL=info                                             (trace, debug, info, warn, error, silent)
# LOG_PRETTY=true                                            (salida legible para desarrollo)
# TRUST_PROXY=1                                              (detrás de un proxy: true, cantidad de saltos o subredes; sin definir se ignora X-Forwarded-For y la IP de la bitácora es la de la conexión)
