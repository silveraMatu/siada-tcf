# Clave del proveedor del LLM (Ollama Cloud / compatible con OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-nano:30b-cloud
LLM_TIMEOUT_SECONDS=60

# development abre CORS a cualquier origen; en otro valor queda cerrado
ENVIRONMENT=development

# Clave que el backend de SIADA envía en el header X-API-Key (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32
SERVICE_API_KEY=

# Rol de solo lectura del agente (se crea con backend/scripts/crear-rol-ia-lectura.sql).
# Formato: postgresql+asyncpg://siada_ia_ro:<clave>@127.0.0.1:5432/<base>
DATABASE_URL=

# Límites de la herramienta SQL (valores por defecto)
# SQL_MAX_FILAS=50
# SQL_TIMEOUT_SEGUNDOS=5
# SQL_MAX_ITERACIONES=5
