# Clave del proveedor del LLM (Ollama Cloud / compatible con OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-nano:30b-cloud
LLM_TIMEOUT_SECONDS=60

# development abre CORS a cualquier origen; en otro valor queda cerrado
ENVIRONMENT=development

# Clave que el backend de SIADA envía en el header X-API-Key (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32
SERVICE_API_KEY=
